#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 2 ]; then
  echo "Usage: $0 <PROJECT_ID> <SERVICE_ACCOUNT_EMAIL>"
  echo "Example: $0 my-project my-sa@my-project.iam.gserviceaccount.com"
  exit 2
fi

PROJECT_ID="$1"
SA_EMAIL="$2"

SECRETS=(telegram-bot-token telegram-chat-id anthropic-api-key api-secret-token)

for s in "${SECRETS[@]}"; do
  echo "Granting secretAccessor to ${SA_EMAIL} on secret ${s} in project ${PROJECT_ID}..."
  gcloud secrets add-iam-policy-binding "${s}" \
    --project "${PROJECT_ID}" \
    --member="serviceAccount:${SA_EMAIL}" \
    --role="roles/secretmanager.secretAccessor" || {
      echo "Failed to grant access for secret ${s}." >&2
      exit 3
    }
done

echo "Done. Verify with: gcloud secrets get-iam-policy <secret-name> --project ${PROJECT_ID}"
